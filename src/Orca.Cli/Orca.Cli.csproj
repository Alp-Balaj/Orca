<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orca</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orca.Core\Orca.Core.csproj" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <!-- Version = 1.0.<commit count>, plus -dirty when tracked files have uncommitted
       changes, so every commit packs a distinguishable .nupkg and `dotnet tool list` can
       answer "is this the build I think it is". Must run as a target (not a static
       property): the value has to come from git at build time, and PackageVersion is
       captured from Version during static evaluation, so it is re-set here explicitly.
       The short SHA lands in InformationalVersion via SourceRevisionId (SDK appends
       "+g<sha>"). The dirty check skips untracked files (like `git describe -dirty`)
       so unignored local noise — e.g. `.claude/` in the main checkout — can't flag
       every build dirty. -->
  <Target Name="ComputeVersionFromGit"
          BeforeTargets="GetAssemblyVersion;GenerateNuspec"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>
    <PropertyGroup>
      <_GitDirtySuffix Condition="'$(_GitStatus)' != ''">-dirty</_GitDirtySuffix>
      <Version>1.0.$(_GitCommitCount)$(_GitDirtySuffix)</Version>
      <PackageVersion>$(Version)</PackageVersion>
      <SourceRevisionId>g$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
