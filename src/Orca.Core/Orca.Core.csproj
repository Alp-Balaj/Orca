<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Role prompts stay versioned at /prompts (spec: prompts as files) and ride into
         the assembly so the packed `orca` tool carries them; the recorded prompt-file
         hash is of this embedded content. -->
    <EmbeddedResource Include="../../prompts/planner.md" LogicalName="Orca.Core.Prompts.planner.md" />
    <EmbeddedResource Include="../../prompts/reconciler.md" LogicalName="Orca.Core.Prompts.reconciler.md" />
    <EmbeddedResource Include="../../prompts/scout.md" LogicalName="Orca.Core.Prompts.scout.md" />
    <EmbeddedResource Include="../../prompts/verifier.md" LogicalName="Orca.Core.Prompts.verifier.md" />
    <EmbeddedResource Include="../../prompts/interviewer.md" LogicalName="Orca.Core.Prompts.interviewer.md" />
    <EmbeddedResource Include="../../prompts/summarizer.md" LogicalName="Orca.Core.Prompts.summarizer.md" />
  </ItemGroup>

</Project>
